#!/usr/bin/env bash
#
# gh-ro — a strictly read-only wrapper around `gh api`.
#
# Why this exists: `gh api` can issue any HTTP method, and the logged-in token
# carries write scopes (repo, workflow, gist). Allowlisting bare `gh api` would
# hand out write access. This wrapper forces `--method GET` and refuses every
# flag or endpoint that could mutate state (or mask a mutation), so it is safe
# to add to an unattended allowlist.
#
# Design: allowlist, not denylist. Any flag not explicitly permitted below is
# rejected. The HTTP method is hard-coded to GET and cannot be overridden.
#
# Usage:
#   gh-ro <endpoint> [safe flags...]
#
# Examples:
#   gh-ro repos/foo/bar/pulls/1631/comments --paginate
#   gh-ro repos/bar/bar/pulls/8634/reviews -q '.[].user.login'
#   gh-ro --hostname github.custom.example.com repos/foo/bar/pulls/8634/comments
#
set -euo pipefail

PROG="gh-ro"

die() { printf '%s: %s\n' "$PROG" "$1" >&2; exit 2; }

# `gh api -F key=@path` reads the value from a local file, and `@-` from stdin,
# which would ship file contents to the API host as a query parameter. Only
# -F/--field has this magic; -f/--raw-field is always a literal string.
check_field_value() {
  local flag="$1" pair="$2" value="${2#*=}"
  [[ "$value" == @* ]] && die "refused: $flag value starts with @ ($pair) — gh would read it from a file; use -f/--raw-field for a literal value"
  return 0
}

# Reduce an endpoint to its API path so the graphql check cannot be dodged by a
# leading slash, a full URL, or a query string. Case-folded because the
# comparison should not depend on it.
endpoint_path() {
  local e="$1"
  if [[ "$e" == *"://"* ]]; then
    e="${e#*://}"
    if [[ "$e" == */* ]]; then e="${e#*/}"; else e=""; fi
  fi
  while [[ "$e" == /* ]]; do e="${e#/}"; done
  e="${e%%\?*}"
  printf '%s' "$e" | tr '[:upper:]' '[:lower:]'
}

usage() {
  cat >&2 <<'EOF'
gh-ro — read-only `gh api` (GET only)

Usage:
  gh-ro <endpoint> [safe flags...]

Permitted flags:
  --hostname H        target host (e.g. github.example.com)
  --paginate          follow pagination
  --slurp             with --paginate, collect pages into one array
  -i, --include       include HTTP response headers in output
  --cache DUR         cache the response (e.g. 1h)
  -q, --jq EXPR       filter output with jq (client-side, read-only)
  -f, -F, --field, --raw-field KEY=VALUE
                      request parameters — sent as QUERY STRING under GET

Refused (would allow or hide a write, or read a local file):
  -X, --method        HTTP method override (locked to GET)
  --input             request body
  -H, --header        custom headers (blocks method-override headers)
  -F KEY=@VALUE       gh reads @-prefixed field values from a file (or stdin
                      for @-), which would send local file contents to the
                      API host — use -f/--raw-field for a literal value
  graphql             GraphQL endpoint (can carry mutations)
  --                  argument passthrough
  any unrecognised flag
EOF
  exit 2
}

[ $# -eq 0 ] && usage

endpoint=""
args=()

while [ $# -gt 0 ]; do
  arg="$1"
  case "$arg" in
    -h|--help) usage ;;

    # --- refused: anything that can write, or mask a write ---
    -X|--method|-X*|--method=*)
      die "refused: HTTP method override ($arg) — this wrapper is GET-only" ;;
    --input|--input=*|--input-file|--input-file=*)
      die "refused: $arg sends a request body (write)" ;;
    -H|--header|-H*|--header=*)
      die "refused: -H/--header not allowed (blocks method-override headers)" ;;

    # --- allowed: value-less flags ---
    --paginate|--slurp|-i|--include)
      args+=("$arg"); shift ;;

    # --- allowed: --flag=value form ---
    --hostname=*|--cache=*|--jq=*)
      args+=("$arg"); shift ;;
    --field=*|--raw-field=*)
      body="${arg#*=}"
      [[ "$body" == *"="* ]] || die "refused: field must be KEY=VALUE ($arg)"
      [[ "$arg" == --field=* ]] && check_field_value "--field" "$body"
      args+=("$arg"); shift ;;

    # --- allowed: flag + separate value ---
    --hostname|--cache|--jq|-q)
      [ $# -ge 2 ] || die "flag $arg needs a value"
      args+=("$arg" "$2"); shift 2 ;;
    -f|-F|--field|--raw-field)
      [ $# -ge 2 ] || die "flag $arg needs a value"
      [[ "$2" == *"="* ]] || die "refused: field must be KEY=VALUE ($arg $2)"
      case "$arg" in
        -F|--field) check_field_value "$arg" "$2" ;;
      esac
      args+=("$arg" "$2"); shift 2 ;;

    # --- everything else ---
    --)
      die "refused: -- passthrough not allowed" ;;
    -*)
      die "refused: unrecognised flag $arg (allowlist only)" ;;
    *)
      [ -z "$endpoint" ] || die "refused: multiple positional args ($endpoint, $arg)"
      endpoint="$arg"; shift ;;
  esac
done

[ -n "$endpoint" ] || die "no endpoint given (try: $PROG --help)"

# Reject a GraphQL endpoint however it arrives: bare, slash-prefixed, as a full
# URL, or with a query string. Matching the normalised path rather than the raw
# argument keeps repos that merely contain "graphql" in their name usable.
case "$(endpoint_path "$endpoint")" in
  graphql|graphql/*) die "refused: graphql endpoint can carry mutations" ;;
esac

# --method GET is hard-coded and comes before user args; -X/--method are already
# rejected above, so the method cannot be changed. Empty-array-safe expansion
# keeps this working under `set -u`.
exec gh api --method GET "$endpoint" ${args[@]+"${args[@]}"}
