#!/usr/bin/env bash
set -u

# Desktop notification adapter for Claude hooks, Codex notify payloads, and
# wrappers that forward either form.

terminal_has_focus() {
    local frontmost_app
    frontmost_app=$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)

    case "$frontmost_app" in
        "Terminal"|"iTerm2"|"iTerm"|"Alacritty"|"kitty"|"WezTerm"|"Hyper")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

json_payload=""
title="AI assistant"

for argument in "$@"; do
    if [[ "$argument" == \{* ]]; then
        json_payload="$argument"
    elif [[ "$argument" != "turn-ended" && "$argument" != "--previous-notify" && "$argument" != \[* ]]; then
        title="$argument"
    fi
done

if [[ -z "$json_payload" && ! -t 0 ]]; then
    stdin_payload=$(cat)
    if [[ "$stdin_payload" == \{* ]]; then
        json_payload="$stdin_payload"
    fi
fi

event=""
if [[ -n "$json_payload" ]] && command -v jq >/dev/null 2>&1; then
    event=$(jq -r '.type // .hook_event_name // empty' <<< "$json_payload" 2>/dev/null)
fi

message="Input needed"
case "$event" in
    agent-turn-complete|Stop)
        message="Turn complete"
        [[ "$title" == "AI assistant" ]] && title="Codex"
        ;;
    PermissionRequest|Elicitation|approval-requested)
        message="Approval required"
        ;;
esac

# Exit without notification if in Vim/Neovim via ACP.
if [[ -n "${VIMRUNTIME:-}" || -n "${NVIM_LISTEN_ADDRESS:-}" ]]; then
    exit 0
fi

if terminal_has_focus; then
    command -v afplay >/dev/null 2>&1 && afplay /System/Library/Sounds/Tink.aiff >/dev/null 2>&1 &
elif command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "$title" -message "$message" -sound Tink -group "ai-dx-$title-$event"
elif command -v afplay >/dev/null 2>&1; then
    afplay /System/Library/Sounds/Tink.aiff >/dev/null 2>&1 &
fi
