#!/bin/bash

MOD_PATH='node_modules'
BIN_PATH="$MOD_PATH/.bin"
if [[ -n "$NODE_LINK_ROOT" ]]; then
	ROOT="$NODE_LINK_ROOT"
else
	GIT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
	if [[ -n "$GIT_COMMON_DIR" ]]; then
		ROOT=$(dirname "$(dirname "$GIT_COMMON_DIR")")
	else
		ROOT=$(readlink -f "../")
	fi
fi
CONFIG_FILE='package.json'

UNLINK=false
CLEAN_STALE=false
FORCE=false

while [[ $# -gt 0 ]]; do
	case $1 in
		--unlink)
			UNLINK=true
			shift
			;;
		--clean-stale)
			CLEAN_STALE=true
			shift
			;;
		--force)
			FORCE=true
			shift
			;;
		-n)
			MOD_PATH="$MOD_PATH/$2"
			shift 2
			;;
		--)
			shift
			break
			;;
		-*)
			echo "Usage: node-link [-n @namespace] [--unlink] [--clean-stale] [--force] modules..."
			exit 1
			;;
		*)
			break
			;;
	esac
done

# Parse modules and extract worktree information
# Using parallel arrays for compatibility with older bash versions
MODULE_WORKTREE_KEYS=()
MODULE_WORKTREE_VALUES=()
PARSED_MODULES=()

for MODULE_SPEC in "$@"; do
	if [[ "$MODULE_SPEC" == *"/"* ]]; then
		MODULE_NAME="${MODULE_SPEC%%/*}"
		WORKTREE="${MODULE_SPEC#*/}"
		MODULE_WORKTREE_KEYS+=("$MODULE_NAME")
		MODULE_WORKTREE_VALUES+=("$WORKTREE")
		PARSED_MODULES+=("$MODULE_NAME")
	else
		PARSED_MODULES+=("$MODULE_SPEC")
	fi
done

MODULES=("${PARSED_MODULES[@]}")
TARGET_MODULES=("${PARSED_MODULES[@]}")

# Helper function to get worktree name for a module
get_worktree() {
	local MODULE="$1"
	for i in "${!MODULE_WORKTREE_KEYS[@]}"; do
		if [[ "${MODULE_WORKTREE_KEYS[$i]}" == "$MODULE" ]]; then
			echo "${MODULE_WORKTREE_VALUES[$i]}"
			return
		fi
	done
}

# Resolve the actual path of a worktree by looking it up via git
resolve_worktree_path() {
	local MODULE="$1"
	local WORKTREE="$2"
	local MODULE_DIR="$ROOT/$MODULE"

	if [[ ! -d "$MODULE_DIR" ]]; then
		return 1
	fi

	local WORKTREE_PATH
	WORKTREE_PATH=$(git -C "$MODULE_DIR" worktree list --porcelain 2>/dev/null | awk -v name="$WORKTREE" '
		/^worktree / { path = substr($0, 10) }
		/^branch / {
			branch = substr($0, 8)
			# strip refs/heads/ prefix
			sub(/^refs\/heads\//, "", branch)
			if (branch == name) { print path; exit }
		}
	')

	if [[ -n "$WORKTREE_PATH" ]]; then
		echo "$WORKTREE_PATH"
		return 0
	fi

	return 1
}

# Is this symlink one that node-link created?
#
# "Is a symlink" is not enough: pnpm symlinks every dependency into
# node_modules/.pnpm, and both npm and pnpm symlink file:/link: deps and
# workspace members. So we require two things:
#   1. a _$NAME backup marker sitting alongside it (node-link put it there;
#      no package manager creates these), and
#   2. a target outside this project (ours point at sibling repos; store
#      links resolve back inside node_modules).
# Requiring both also catches a stale marker left behind when pnpm reclaims
# a link during an install — marker present, but target back inside.
is_our_link() {
	local MOD_DIR="$1"
	local NAME="$2"
	local LINK="$MOD_DIR/$NAME"

	[[ -L "$LINK" ]] || return 1
	[[ -e "$MOD_DIR/_$NAME" || -L "$MOD_DIR/_$NAME" ]] || return 1

	# Dangling link with a marker is ours, and broken.
	[[ -d "$LINK" ]] || return 0

	local TARGET
	TARGET=$(cd "$LINK" 2>/dev/null && pwd -P) || return 1
	[[ -n "$TARGET" && "$TARGET" != "$(pwd -P)"/* ]]
}

# Print the names of symlinks in $1 that node-link created.
our_links() {
	local MOD_DIR="$1"
	local ENTRY NAME

	[[ -d "$MOD_DIR" ]] || return
	for ENTRY in "$MOD_DIR"/*; do
		[[ -L "$ENTRY" ]] || continue
		NAME=$(basename "$ENTRY")
		[[ "$NAME" == _* ]] && continue
		if is_our_link "$MOD_DIR" "$NAME"; then
			echo "$NAME"
		fi
	done
	return 0
}

# Print the names of backup markers sitting beside a live link that is not
# ours, i.e. the package manager reclaimed the module during an install.
# Restoring one of these would put a stale version back over a correct one.
#
# A marker with no link beside it is NOT stale — it is the only remaining copy
# of that module, so it is reported separately and never deleted.
stale_markers() {
	local MOD_DIR="$1"
	local ENTRY NAME

	[[ -d "$MOD_DIR" ]] || return 0
	for ENTRY in "$MOD_DIR"/_*; do
		[[ -e "$ENTRY" || -L "$ENTRY" ]] || continue
		NAME=$(basename "$ENTRY")
		NAME="${NAME#_}"
		[[ -e "$MOD_DIR/$NAME" || -L "$MOD_DIR/$NAME" ]] || continue
		if ! is_our_link "$MOD_DIR" "$NAME"; then
			echo "$NAME"
		fi
	done
	return 0
}

# Print the names of backup markers with no link beside them at all. These hold
# the only copy of the module, so they are never removed automatically.
orphaned_markers() {
	local MOD_DIR="$1"
	local ENTRY NAME

	[[ -d "$MOD_DIR" ]] || return 0
	for ENTRY in "$MOD_DIR"/_*; do
		[[ -e "$ENTRY" || -L "$ENTRY" ]] || continue
		NAME=$(basename "$ENTRY")
		NAME="${NAME#_}"
		[[ -e "$MOD_DIR/$NAME" || -L "$MOD_DIR/$NAME" ]] && continue
		echo "$NAME"
	done
	return 0
}

# Was this module named on the command line?
is_target() {
	local NAME="$1" T
	for T in "${TARGET_MODULES[@]}"; do
		[[ "$T" == "$NAME" ]] && return 0
	done
	return 1
}

# Which package manager owns this repo? Used only for advice in messages.
pkg_manager() {
	if command -v pkg-manager > /dev/null 2>&1; then
		pkg-manager
	elif [[ -f pnpm-lock.yaml ]]; then
		echo pnpm
	else
		echo npm
	fi
}

# if no modules then print all symlinks found in $MOD_PATH

if [ -z "$MODULES" ]; then
	our_links "$MOD_PATH"
	exit 0
fi

DEPS=()
while IFS= read -r line; do
	[[ -n "$line" ]] && DEPS+=("$line")
done < <(our_links "$MOD_PATH")
DEPS+=("$PWD")

function gatherDeps() {
	local MODULE_DIR="$1"

	if [[ "$MODULE_DIR" == /* ]]; then
		if [[ ! -d "$MODULE_DIR" ]]; then
			return
		fi
		pushd "$MODULE_DIR" > /dev/null || return
	else
		local WORKTREE=$(get_worktree "$MODULE_DIR")

		if [[ -n "$WORKTREE" ]]; then
			local WORK_PATH
			WORK_PATH=$(resolve_worktree_path "$MODULE_DIR" "$WORKTREE")
			if [[ $? -eq 0 && -d "$WORK_PATH" ]]; then
				pushd "$WORK_PATH" > /dev/null || return
			else
				pushd "$ROOT/$MODULE_DIR" > /dev/null || return
			fi
		else
			if [[ -d "$ROOT/$MODULE_DIR" ]]; then
				pushd "$ROOT/$MODULE_DIR" > /dev/null || return
			else
				return
			fi
		fi
	fi

	MODULES+=("$MODULE_DIR")

	if [[ -d "$MOD_PATH" ]]; then
		while IFS= read -r SUB_DEP; do
			[[ -n "$SUB_DEP" ]] && MODULES+=("$SUB_DEP")
		done < <(our_links "$MOD_PATH")
	fi

	popd > /dev/null
}

function loopDeps() {
	local DIRS=("$@")
	for DIR in "${DIRS[@]}"; do
		if [[ -z $DIR ]]; then
			continue
		fi

		if [[ "$DIR" == /* ]]; then
			gatherDeps "$DIR"
		else
			gatherDeps "$(basename "$DIR")"
		fi
	done
}

loopDeps "${MODULES[@]}"
loopDeps "${DEPS[@]}"

MODULES=($(echo "${MODULES[@]}" | tr ' ' '\n' | sort -u))

echo "found ${MODULES[@]}"

MISSING_BACKUPS=()
DANGLING_RESTORES=()
STALE_MARKERS=()
ORPHANED_MARKERS=()

for DIR in "${MODULES[@]}"; do
	if [[ -z $DIR ]]; then
		continue
	fi

	# A failed pushd would desync the stack and push every later operation
	# into the wrong directory, so skip anything we cannot enter.
	if [[ "$DIR" == /* ]]; then
		pushd "$DIR" > /dev/null || continue
	else
		pushd "$ROOT/$DIR" > /dev/null || continue
	fi
	echo "checking $PWD"

	while IFS= read -r STALE; do
		if [[ -n "$STALE" ]]; then
			# Only ever delete a backup for a module named on the command
			# line, so --clean-stale cannot touch unrelated modules.
			if $CLEAN_STALE && is_target "$STALE"; then
				rm -rf "${MOD_PATH:?}/_$STALE"
				echo "removed stale backup _$STALE"
			else
				STALE_MARKERS+=("$STALE in $PWD")
			fi
		fi
	done < <(stale_markers "$MOD_PATH")

	while IFS= read -r ORPHAN; do
		[[ -n "$ORPHAN" ]] && ORPHANED_MARKERS+=("$ORPHAN in $PWD")
	done < <(orphaned_markers "$MOD_PATH")

	for MODULE in "${TARGET_MODULES[@]}"; do
		MODULE_PATH="$MOD_PATH/$MODULE"
		BACKUP_PATH="$MOD_PATH/_$MODULE"

		if $UNLINK; then
			# Unlink mode: remove symlink and restore backed-up module.
			# Only touch links we created — a bare symlink here could be a
			# pnpm store link, a file:/link: dep or a workspace member.
			if [[ -L "$MODULE_PATH" ]] && ! $FORCE \
					&& ! is_our_link "$MOD_PATH" "$MODULE"; then
				if [[ -e "$BACKUP_PATH" || -L "$BACKUP_PATH" ]]; then
					: # stale marker, already reported above
				else
					echo "skipping $MODULE (symlink not created by node-link — no _$MODULE backup; use --force to remove it anyway)"
				fi
			elif [[ -L "$MODULE_PATH" ]]; then
				# Read bin entries before removing the symlink (it points to
				# the source module). If the link is dangling we cannot read
				# through it, so fall back to the backup and then the source,
				# or the .bin shims would be left pointing at nothing.
				BIN_SOURCE="$MODULE_PATH"
				if [[ ! -f "$MODULE_PATH/$CONFIG_FILE" ]]; then
					if [[ -f "$BACKUP_PATH/$CONFIG_FILE" ]]; then
						BIN_SOURCE="$BACKUP_PATH"
					elif [[ -f "$ROOT/$MODULE/$CONFIG_FILE" ]]; then
						BIN_SOURCE="$ROOT/$MODULE"
					fi
				fi
				SCRIPTS=$(jq -r '.bin | to_entries | .[] | "\(.key):\(.value)"' "$BIN_SOURCE/$CONFIG_FILE" 2> /dev/null)
				if [[ -n $SCRIPTS ]]; then
					for SCRIPT in $SCRIPTS; do
						CMD=$(echo $SCRIPT | cut -d ':' -f 1)
						BIN_BACKUP="$BIN_PATH/_$CMD"

						rm -f "$BIN_PATH/$CMD"
						if [[ -e "$BIN_BACKUP" || -L "$BIN_BACKUP" ]]; then
							mv "$BIN_BACKUP" "$BIN_PATH/$CMD"
							echo "restored bin script $CMD"
						else
							echo "removed bin script $CMD (no backup to restore)"
						fi
					done
				fi

				rm "$MODULE_PATH"
				if [[ -d "$BACKUP_PATH" || -L "$BACKUP_PATH" ]]; then
					mv "$BACKUP_PATH" "$MODULE_PATH"
					# Under pnpm the restored entry is a symlink into
					# .pnpm/<pkg>@<version>, which a store prune or a
					# lockfile change can invalidate.
					if [[ -d "$MODULE_PATH" ]]; then
						echo "unlinked $MODULE, restored from backup"
					else
						DANGLING_RESTORES+=("$MODULE in $DIR")
						echo "unlinked $MODULE, but the restored module does not resolve"
					fi
				else
					MISSING_BACKUPS+=("$MODULE in $DIR")
					echo "unlinked $MODULE (no backup to restore)"
				fi
			fi
		else
			# Link mode: back up existing module and create symlink
			if [[ -d "$MODULE_PATH" || -L "$MODULE_PATH" ]]; then
				if is_our_link "$MOD_PATH" "$MODULE" \
						|| [[ -L "$MODULE_PATH" \
							&& ( -e "$BACKUP_PATH" || -L "$BACKUP_PATH" ) ]]; then
					# Re-linking something already linked: drop our old link
					# and keep the existing backup, or we would overwrite the
					# real module with a copy of our own symlink.
					#
					# The second test is the same protection for a symlink we
					# cannot attribute (e.g. the source lives inside this
					# project, so the "outside" test fails): a backup already
					# exists, so never overwrite it with a link.
					rm "$MODULE_PATH"
				else
					# Always preserve the original, whether it is a real
					# directory (npm) or a symlink into the store (pnpm).
					if [[ -e "$BACKUP_PATH" || -L "$BACKUP_PATH" ]]; then
						rm -rf "$BACKUP_PATH"
					fi
					mv "$MODULE_PATH" "$BACKUP_PATH"
				fi

				# Check if this module has a worktree specified
				WORKTREE=$(get_worktree "$MODULE")
				if [[ -n "$WORKTREE" ]]; then
					WORKTREE_PATH=$(resolve_worktree_path "$MODULE" "$WORKTREE")
					if [[ $? -eq 0 && -d "$WORKTREE_PATH" ]]; then
						ln -s "$WORKTREE_PATH" "$MODULE_PATH"
						echo "linking $MODULE from $WORKTREE_PATH (worktree: $WORKTREE)"
						MODULE_SOURCE="$WORKTREE_PATH"
					else
						echo "Warning: worktree '$WORKTREE' not found for $MODULE, falling back to main"
						ln -s "$ROOT/$MODULE" "$MODULE_PATH"
						echo "linking $MODULE from $ROOT"
						MODULE_SOURCE="$ROOT/$MODULE"
					fi
				else
					ln -s "$ROOT/$MODULE" "$MODULE_PATH"
					echo "linking $MODULE from $ROOT"
					MODULE_SOURCE="$ROOT/$MODULE"
				fi

				SCRIPTS=$(jq -r '.bin | to_entries | .[] | "\(.key):\(.value)"' $MODULE_SOURCE/$CONFIG_FILE 2> /dev/null)
				if [[ -n $SCRIPTS ]]; then
					for SCRIPT in $SCRIPTS; do
						CMD=$(echo $SCRIPT | cut -d ':' -f 1)
						CMD_PATH=$(echo $SCRIPT | cut -d ':' -f 2)

						echo "Attaching script $CMD to $CMD_PATH"

						if [[ -e "$BIN_PATH/$CMD" || -L "$BIN_PATH/$CMD" ]]; then
							if [[ ! -e "$BIN_PATH/_$CMD" && ! -L "$BIN_PATH/_$CMD" ]]; then
								mv "$BIN_PATH/$CMD" "$BIN_PATH/_$CMD"
							else
								rm -f "$BIN_PATH/$CMD"
							fi
						fi
						ln -s "$MODULE_SOURCE/$CMD_PATH" "$BIN_PATH/$CMD"
						chmod +x "$BIN_PATH/$CMD"
					done
				fi
			fi
		fi
	done

	popd > /dev/null
done

if [[ ${#MISSING_BACKUPS[@]} -gt 0 ]]; then
	echo ""
	echo "Warning: The following modules could not be reinstated (no backup found):"
	for ENTRY in "${MISSING_BACKUPS[@]}"; do
		echo "  - $ENTRY"
	done
	echo "  Run '$(pkg_manager) install' to reinstate them."
fi

if [[ ${#DANGLING_RESTORES[@]} -gt 0 ]]; then
	echo ""
	echo "Warning: The following modules were restored but do not resolve:"
	for ENTRY in "${DANGLING_RESTORES[@]}"; do
		echo "  - $ENTRY"
	done
	echo "  The store entry they point at is gone. Run '$(pkg_manager) install'."
fi

if [[ ${#STALE_MARKERS[@]} -gt 0 ]]; then
	echo ""
	echo "Warning: The following backups are stale — the package manager has"
	echo "reclaimed the module since it was linked, so the backup is out of date:"
	for ENTRY in "${STALE_MARKERS[@]}"; do
		echo "  - $ENTRY"
	done
	echo "  These are being left alone. Name the module with --clean-stale to remove its backup."
fi

if [[ ${#ORPHANED_MARKERS[@]} -gt 0 ]]; then
	echo ""
	echo "Note: The following backups have no module beside them, so they hold"
	echo "the only remaining copy and were left untouched:"
	for ENTRY in "${ORPHANED_MARKERS[@]}"; do
		echo "  - $ENTRY"
	done
fi






